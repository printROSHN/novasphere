# ============================================================================
# NovaSphere Exim / ASMI Tech - Environment Configuration
# 
# For Local Development:
#   Copy this file to .env and replace with your Supabase credentials
# 
# For Vercel Deployment (Free):
#   Add these variables in your Vercel Dashboard -> Project -> Settings -> Environment Variables
# ============================================================================

# Supabase API URL (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (from Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
